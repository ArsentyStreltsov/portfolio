# Required for /api/brief — random hard-to-guess topic; subscribe to the same name in the ntfy app
NTFY_TOPIC=arsenty-portfolio-briefs-changeme

# Optional — defaults to https://ntfy.sh
# NTFY_URL=https://ntfy.sh

# Canonical site URL for SEO, Open Graph, sitemap, robots (required in production)
NEXT_PUBLIC_SITE_URL=https://arsentystreltsov.com

# PostHog EU (project API key + host from PostHog project settings)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Outreach link hits (lead_id only) are logged server-side to data/outreach-hits.jsonl
# without cookies / without PostHog — even if analytics consent is rejected.

# Admin CRM at /admin (password login + encrypted session cookie)
ADMIN_PASSWORD=password
# Random string, at least 32 characters (openssl rand -base64 32)
ADMIN_SESSION_SECRET=1111

# Optional — PostHog person link + pull behaviour into admin lead detail
# Project ID: PostHog → Project settings → Project ID (number)
# Personal API key: PostHog → Settings → Personal API keys → create with "Query" / project read
# POSTHOG_PROJECT_ID=12345
# NEXT_PUBLIC_POSTHOG_PROJECT_ID=12345
# POSTHOG_PERSONAL_API_KEY=phx_...
